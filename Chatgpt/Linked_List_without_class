/******************************************************************************
Linked List using C++

*******************************************************************************/
#include <iostream>

using namespace std;

struct Node{
    int data;
    Node* next;
    
    Node(int idata){
        data = idata;
        next = nullptr;
    }
};

int main()
{
    Node* a = new Node(10);
    Node* b = new Node(20);
    Node* c = new Node(30);
    
    a->next = b;
    b->next = c;
    
    Node* temp = a;
    while(temp != nullptr){
        cout << temp->data << endl;
        temp = temp->next;
    }
    
    cout << "Reached EOL" << endl;
    return 0;
}
