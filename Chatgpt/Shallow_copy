/******************************************************************************
Shallow Copy
*******************************************************************************/
#include <iostream>

using namespace std;

class Box{
    public:
        int* length;
        
        Box(int l){
            length = new int(l);
        }
};

int main(){
    Box b1(10);
    Box b2 = b1;
    
    cout << *b1.length << endl;
    cout << *b2.length << endl;
    
    *b1.length = 20;
    
    cout << *b1.length << endl;
    cout << *b2.length << endl;
    return 0;
}
