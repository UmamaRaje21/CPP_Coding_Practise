/******************************************************************************
Implement a class with constructors and destructors 

*******************************************************************************/
#include <iostream>
#include <string>

using namespace std;

class HumanBeing{
    private:
        int age;
        string name;
        int *rating;
    
    public:
        /* Constructor with no parameter */
        HumanBeing(): name("noname"), age(0){
            rating = new int[5]{0};
            cout << "Default Constructor with no name and zero age" << endl;
        }
        
        /*Parameterized constructor*/
        HumanBeing(string iname, int iage){
            name = iname;
            age = iage;
            rating = new int[5]{0};
        }
        
        /*Constructor using Deep copy */
        
        HumanBeing(const HumanBeing& d_human){
            name = d_human.name;
            age = d_human.age;
            rating = new int[5];
            for (int i=0; i<5; i++){
                rating[i] = d_human.rating[i];
            }
        }
        
        string get_name(){
            return name;
        }
        
        int get_age(){
            return age;
        }
        
        ~HumanBeing(){
            delete []rating;
            cout << "Deallocated the memory" << endl;
        }
};

int main()
{
    HumanBeing Nisa;
    cout << Nisa.get_age() << endl;
    cout << Nisa.get_name() << endl;
    
    HumanBeing Sarah("Sarah", 35);
    cout << Sarah.get_age() << endl;
    cout << Sarah.get_name() << endl;
    
    HumanBeing Peter = Sarah;
    cout << Peter.get_age() << endl;
    cout << Peter.get_name() << endl;
    
    return 0;
}
