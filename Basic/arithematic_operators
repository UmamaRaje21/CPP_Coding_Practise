/* This CPP program shows the use of 
1. Arithematic operators
2. Cin and Cout
3. Block Comment
4. SIngle Line Comment */

#include <iostream>

using namespace std;

int main()
{
  int num1, num2;
  cin >> num1 >> num2;
  cout << num1 + num2 << endl; // Addition
  cout << num1 - num2 << endl; // Substraction
  cout << num1 * num2 << endl; // Multiplication
  cout << num1 / num2 << endl; // Division
  cout << num1 % num2 << endl; // Modulus
  
}
