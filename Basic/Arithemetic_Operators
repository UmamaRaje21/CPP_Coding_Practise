/* This program shows the use of the arithemetic operators 
 1. Addition
 2. Substraction
 3. Multiplication
 4. Division
 5. Modulus */

#include <iostream>

using namespace std;

int main()
{
  int val_1 = 10, val_2 = 20, result = 0;

  // Addition
  result = val_1 + val_2;
  cout << "Addition of " << val_1 << " and " << val_2 << " results in " << result << endl;

  // Substraction
  result = val_1 - val_2;
  cout << "Substraction of " << val_1 << " and " << val_2 << " results in " << result << endl;

  // Multiplication
  result = val_1 * val_2;
  cout << "Multiplication of " << val_1 << " and " << val_2 << " results in " << result << endl;

  // Division (This provides quotient value in the result)
  result = val_1 / val_2;
  cout << "Division of " << val_1 << " and " << val_2 << " results in " << result << endl;

  // Modulus (This provides remainder value in the result)
  result = val_1 % val_2;
  cout << "Modulus of " << val_1 << " and " << val_2 << " results in " << result << endl;
  
  return 0;
}
