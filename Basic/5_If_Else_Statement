// This file shows the implementation of Conditional Statements
// It consist of If Else statement

#include <iostream>

using namespace std;

int main(){
    int age = 18;
    if ( age >= 18){
      cout << "You can get the driving license" << endl;
    }else{
      cout << "You are underage, hence you cannot get the driving license" << endl;
    }
    return 0;    
}
